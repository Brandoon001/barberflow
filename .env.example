# Ambiente: development | testing | production
FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Banco de dados
DATABASE_PATH=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Marca white-label
MARCA_NOME=BarberFlow
MARCA_SLOGAN=Seu próximo corte começa aqui.
MARCA_TELEFONE=
MARCA_WHATSAPP=
MARCA_ENDERECO=
MARCA_INSTAGRAM=
TEMA=urbano

# Agendamento
AGENDAMENTO_INTERVALO_MINUTOS=30
AGENDAMENTO_DIAS_FUTUROS=60
CANCELAMENTO_MINUTOS_ANTECEDENCIA=30
AGENDAMENTO_CONFIRMACAO_AUTOMATICA=false
TIMEZONE=America/Sao_Paulo

# Sessao e limites
ADMIN_SESSAO_MINUTOS=60
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
